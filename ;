char* PreShader_Run( FILE* fptr, char *src, long srclen )
{
    PreShader_Init( fptr, src );

    root = AllocSegment( srclen);
    memcpy( root->data, src, srclen );
    root->data[srclen] = 0;
    root->size = srclen;
    if (!PreShader_ParseInclude())
    {
        PreShader_Cleanup();
        return NULL;
    }
    printf("Found %d segments\n", numsegments);

    //print_segments(root);

    PreShader_Cleanup();
    root = NULL;
}



